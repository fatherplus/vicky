[Unit]
Description=AI Report Service — 研究报告 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hgf
Group=hgf
# P4：包入口 python3 -m ai_report.web（config.PORT 读 argv[1]=9091；
# WorkingDirectory=/home/deploy/ai-report 保证 -m ai_report 可解析，其余项不动）
ExecStart=/usr/bin/python3 -m ai_report.web 9091
WorkingDirectory=/home/deploy/ai-report
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
