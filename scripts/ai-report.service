[Unit]
Description=AI Report Service — 研究报告 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hgf
Group=hgf
ExecStart=/usr/bin/python3 /home/deploy/ai-report/server.py 9091
WorkingDirectory=/home/deploy/ai-report
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target