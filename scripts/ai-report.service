[Unit]
Description=AI Report Service — 研究报告 API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hgf
Group=hgf
# 包入口 python3 -m ai_report.web（argv[1]=9093 端口、argv[2]=0.0.0.0 绑定，正门直连；
# WorkingDirectory=/home/deploy/ai-report 保证 -m ai_report 可解析，其余项不动）
ExecStart=/usr/bin/python3 -m ai_report.web 9093 0.0.0.0
WorkingDirectory=/home/deploy/ai-report
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
